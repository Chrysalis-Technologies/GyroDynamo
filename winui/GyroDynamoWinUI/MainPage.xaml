<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GyroDynamoWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GyroDynamoWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20" Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="GyroDynamo" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Native WinUI controls driving the desktop visualizer."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Loading visualizer..."
                               TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="ErrorInfoBar"
                         IsOpen="False"
                         Severity="Error"
                         Title="Visualizer error" />

                <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                    <AppBarButton Icon="Play" Label="Start" Click="StartInput_Click" />
                    <AppBarButton Icon="PreviewLink" Label="Demo" Click="Demo_Click" />
                    <AppBarButton Icon="Target" Label="Calibrate" Click="Calibrate_Click" />
                    <AppBarButton Icon="Stop" Label="Stop" Click="StopInput_Click" />
                </CommandBar>

                <StackPanel Spacing="10">
                    <TextBlock Text="Display" FontSize="16" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeComboBox"
                              Header="Theme"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Neon" Tag="neon" />
                        <ComboBoxItem Content="Astrolabe" Tag="astrolabe" />
                        <ComboBoxItem Content="Scientific" Tag="scientific" />
                        <ComboBoxItem Content="Minimal" Tag="minimal" />
                        <ComboBoxItem Content="Dark Glass" Tag="darkGlass" />
                    </ComboBox>
                    <ComboBox x:Name="TrailComboBox"
                              Header="Trails"
                              SelectionChanged="TrailComboBox_SelectionChanged">
                        <ComboBoxItem Content="Off" Tag="off" />
                        <ComboBoxItem Content="Short" Tag="short" />
                        <ComboBoxItem Content="Medium" Tag="medium" />
                        <ComboBoxItem Content="Long" Tag="long" />
                    </ComboBox>
                    <ComboBox x:Name="OrientationComboBox"
                              Header="Orientation"
                              SelectionChanged="OrientationComboBox_SelectionChanged">
                        <ComboBoxItem Content="Portrait" Tag="portrait" />
                        <ComboBoxItem Content="Landscape" Tag="landscape" />
                        <ComboBoxItem Content="Free" Tag="free" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Motion Tuning" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="SensitivityValue" />
                    <Slider x:Name="SensitivitySlider"
                            Minimum="0.1"
                            Maximum="3"
                            StepFrequency="0.1"
                            ValueChanged="SensitivitySlider_ValueChanged" />
                    <TextBlock x:Name="SmoothingValue" />
                    <Slider x:Name="SmoothingSlider"
                            Minimum="0.02"
                            Maximum="1"
                            StepFrequency="0.01"
                            ValueChanged="SmoothingSlider_ValueChanged" />
                    <TextBlock x:Name="DeadZoneValue" />
                    <Slider x:Name="DeadZoneSlider"
                            Minimum="0"
                            Maximum="5"
                            StepFrequency="0.1"
                            ValueChanged="DeadZoneSlider_ValueChanged" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="BPM-Aligned Rig" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="BpmValue" />
                    <Slider x:Name="BpmSlider"
                            Minimum="30"
                            Maximum="220"
                            StepFrequency="1"
                            ValueChanged="BpmSlider_ValueChanged" />
                    <TextBlock x:Name="TempoScaleValue" />
                    <Slider x:Name="TempoScaleSlider"
                            Minimum="0.25"
                            Maximum="3"
                            StepFrequency="0.05"
                            ValueChanged="TempoScaleSlider_ValueChanged" />
                    <TextBlock x:Name="BeatsPerMeasureValue" />
                    <Slider x:Name="BeatsPerMeasureSlider"
                            Minimum="1"
                            Maximum="16"
                            StepFrequency="1"
                            ValueChanged="BeatsPerMeasureSlider_ValueChanged" />
                    <TextBlock x:Name="AlignBarsValue" />
                    <Slider x:Name="AlignBarsSlider"
                            Minimum="1"
                            Maximum="16"
                            StepFrequency="1"
                            ValueChanged="AlignBarsSlider_ValueChanged" />
                    <TextBlock x:Name="RingCountValue" />
                    <Slider x:Name="RingCountSlider"
                            Minimum="1"
                            Maximum="12"
                            StepFrequency="1"
                            ValueChanged="RingCountSlider_ValueChanged" />
                    <TextBlock x:Name="GyroScaleValue" />
                    <Slider x:Name="GyroScaleSlider"
                            Minimum="0.55"
                            Maximum="1.45"
                            StepFrequency="0.01"
                            ValueChanged="GyroScaleSlider_ValueChanged" />
                    <TextBlock x:Name="WobbleValue" />
                    <Slider x:Name="WobbleSlider"
                            Minimum="0"
                            Maximum="2"
                            StepFrequency="0.01"
                            ValueChanged="WobbleSlider_ValueChanged" />
                    <TextBlock x:Name="ShakeValue" />
                    <Slider x:Name="ShakeSlider"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.01"
                            ValueChanged="ShakeSlider_ValueChanged" />
                    <Button Content="Reset Rig" Click="ResetRig_Click" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Overlays" FontSize="16" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="HudToggle"
                                  Header="HUD"
                                  Toggled="HudToggle_Toggled" />
                    <ToggleSwitch x:Name="DebugToggle"
                                  Header="Debug HUD"
                                  Toggled="DebugToggle_Toggled" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" Background="Black">
            <WebView2 x:Name="VisualizerWebView"
                      NavigationCompleted="VisualizerWebView_NavigationCompleted" />
            <ProgressRing x:Name="LoadingRing"
                          Width="48"
                          Height="48"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
